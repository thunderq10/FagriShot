#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D sceneDepth;
layout(set=0,binding=2) uniform accelerationStructureEXT scene;
layout(set=0,binding=3) uniform sampler2D sceneColor;
layout(set=0,binding=4,rgba16f) uniform writeonly image2D result;
layout(std430,set=0,binding=5) buffer Audit { uint traced; uint hits; uint changed; uint geometry; } audit;
layout(push_constant) uniform Params { ivec2 size; ivec2 colorBase; vec2 depthBase; vec2 depthRatio; int reversed; } pc;
vec3 position(ivec2 pixel) {
    vec2 centre = vec2(pixel)+0.5, uv = centre/vec2(pc.size);
    float d=texelFetch(sceneDepth,clamp(ivec2(pc.depthBase+centre*pc.depthRatio),ivec2(0),textureSize(sceneDepth,0)-1),0).r;
    float invZ = pc.reversed!=0 ? d : 1.0-d;
    if (!(invZ>1e-6)) return vec3(0);
    return vec3((uv*2.0-1.0)*vec2(float(pc.size.x)/float(pc.size.y),1.0),1.0)/invZ;
}
void main() {
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(p,pc.size)))return;
    vec3 source=texelFetch(sceneColor,pc.colorBase+p,0).rgb;
    imageStore(result,p,vec4(source,1));
    // This deliberately limited prototype has camera-visible depth only and no material roughness.
    // Restrict it to upward-facing floor-like surfaces. Skip discontinuities and degenerate normals.
    vec3 a=position(p), b=position(min(p+ivec2(2,0),pc.size-1)), c=position(min(p+ivec2(0,2),pc.size-1));
    bool samplePixel=all(equal(p%8,ivec2(4)));
    if(samplePixel && a.z>0.0) atomicAdd(audit.geometry,1);
    if (!(a.z>0.0) || abs(b.z-a.z)>a.z*0.08 || abs(c.z-a.z)>a.z*0.08) return;
    vec3 rawN=cross(b-a,c-a);
    if(dot(rawN,rawN)<1e-15) return;
    vec3 n=normalize(rawN), view=normalize(a);
    if(dot(n,view)>0.0) n=-n;
    if(n.y > -0.45) return;
    vec3 ray=reflect(view,n);
    rayQueryEXT query;
    rayQueryInitializeEXT(query,scene,gl_RayFlagsOpaqueEXT,0xff,a+n*a.z*0.004,a.z*0.006,ray,a.z*60.0);
    while(rayQueryProceedEXT(query)) {}
    // One representative pixel per 8x8 tile gives readback evidence without a global atomic per pixel.
    if(samplePixel) atomicAdd(audit.traced,1);
    if(rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionTriangleEXT) return;
    if(samplePixel) atomicAdd(audit.hits,1);
    vec3 hit=a+n*a.z*0.004+ray*rayQueryGetIntersectionTEXT(query,true);
    if(!(hit.z>0.0))return;
    vec2 uv=0.5+0.5*hit.xy/hit.z*vec2(float(pc.size.y)/float(pc.size.x),1);
    if(any(lessThan(uv,vec2(0)))||any(greaterThanEqual(uv,vec2(1))))return;
    vec3 reflected=texelFetch(sceneColor,pc.colorBase+ivec2(uv*vec2(pc.size)),0).rgb;
    float strength=0.35*pow(1.0-clamp(dot(-view,n),0.0,1.0),2.0);
    vec3 color=mix(source,reflected,strength);
    if(samplePixel && (packHalf2x16(color.rg)!=packHalf2x16(source.rg) ||
                       packHalf2x16(vec2(color.b,0))!=packHalf2x16(vec2(source.b,0)))) atomicAdd(audit.changed,1);
    imageStore(result,p,vec4(color,1));
}
