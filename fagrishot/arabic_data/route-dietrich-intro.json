      ]
    },
    "MID_EV12_001_m01_019": {
      "source_sha256": "c4dbb21825df4ef043e8980d957ab8e611c9974a50ecb6485ace6d01be2cd653",
      "parts": [
        "أنت تعرف سيفي."
      ]
    },
    "MID_EV12_001_m01_020": {
      "source_sha256": "11facc31cce24b8805ced5a58d4307d01c1c93bf3aa7ee2a01e338a4d89803d2",
      "parts": [
        "المجيب، النصل المشؤوم. أثر حملته لامين،\nوهي من النخبة العشرة في فودلان."
      ]
    },
    "MID_EV12_001_m01_021": {
      "source_sha256": "9e95ece33c68f65ba8022534bb270e75b5bd43680895ec925c0c29653427ac23",
      "parts": [
        "أليس إخراجه من تلك الأرض خطيئة جسيمة؟"
      ]
    },
    "MID_EV12_001_m01_022": {
      "source_sha256": "b06a4f4b784bf0b49782866db1c31c72c789417d3692ae8fce7a313d51e52d65",
      "parts": [
        "لم أقصد إخراجه. غرقت سفينتي."
      ]
    },
    "MID_EV12_001_m01_023": {
      "source_sha256": "5eddab19d11de18c767f450008658e5c45c50ac5f42bb58f592af3196d19c23d",
      "parts": [
        "اسمي ديتريش غريغور لامين."
      ]
    },
    "MID_EV12_001_m01_024": {
      "source_sha256": "5b2622eab5f8d28529df2c0e48bb91e847d945099806603cc846a57f778b92d4",
      "parts": [
        "آه، نعم. الآن اتضح الأمر.\nأنت من سلالة لامين، إحدى النخبة العشرة."
      ]
    },
    "MID_EV12_001_m01_025": {
      "source_sha256": "cf5022b0238b6509f65b69622774b23b21df1c3f9441b1d18259601c8d6e056d",
      "parts": [
        "كانت فاتنة حقا. ولا عجب إذن في وسامتك."
      ]
    },
    "MID_EV12_001_m01_026": {
      "source_sha256": "c4105a79e3526cb6c7af2816cd7f4c0c00b92c35ee0493de44c4b52ab6076a05",
      "parts": [
        "توفيت جدتي الكبرى منذ عهد بعيد. لم ألقها قط."
      ]
    },
    "MID_EV12_001_m01_027": {
      "source_sha256": "7eb604bd981de6c52d55961f53e61af361c1f0196f744c7726cd59bde97ce56e",
      "parts": [
        "أما أنت... فتتكلم كأنك لقيتها."
      ]
    },
    "MID_EV12_001_m01_028": {
      "source_sha256": "6a75837229a94f19d82d92cda8a95d7fbd73c5157bb608dd7d3404d7ec4295bc",
      "parts": [
        "هذا أمر تناقله الناس، أليس كذلك؟\nكثيرا ما يتغنى إخوتي في الرهبنة بجمالها."
      ]
    },
    "MID_EV12_001_m01_029": {
      "source_sha256": "da4bebee478cddcd9b424b591b03f9c781b6f8a0122863c6bbca75125a0a3c91",
      "parts": [
        "أجل، كانت عينة بديعة. ما وقعت عليها\nعيناي إلا واختلجت يدي طلبا لمشرطي..."
      ],
      "flow": "auto"
    },
    "MID_EV12_001_m01_030": {
      "source_sha256": "d5b471af310fbcbcb0667f4f9f0166b37db8fa209ef14ec8dda2a07221898f64",
      "parts": [
        "كم جاهدت تلك الرغبة... ترى، أكنت مأخوذا بها؟"
      ],
      "flow": "auto"
    },
    "MID_EV12_001_m01_031": {
      "source_sha256": "bbd3bd486739c125342de931ca93d590644366bf009c11e53446e37e2d7e46fa",
      "parts": [
        "ما هذا الذي تقوله؟"
      ]
    },
    "MID_EV12_001_m01_032": {
      "source_sha256": "b246ec972eb4b7d1e3c5db41cf174c48abfa7c2b74e483e31dee9e21606add14",
      "parts": [
        "عذرا، لا شيء. لكن أجبني عن هذا: ما جاء بك إلى هنا؟"
      ]
    },
    "MID_EV12_001_m01_033": {
      "source_sha256": "5d97c98f105e2d699da42452033ff898c0650d9b4ef62b064270ab77d492aa22",
      "parts": [
        "كنت أقصد جزيرة آيف، حيث حلبة غاي بولغ.\nثم ساقني البحر إلى هنا..."
      ]
    },
    "MID_EV12_001_m01_034": {
      "source_sha256": "9feac59c5420edaaeefe41f5ba78af3f41272070c763b13a1d2b2437d6abd97a",
      "parts": [
        "غاي بولغ؟ لتلك الحلبة سمعة ذائعة في الوحشية.\nما الذي كنت ترجو أن تجده فيها؟"
      ]
    },
    "MID_EV12_001_m01_035": {
      "source_sha256": "4a94c3b1b33c856e26a1e6c7ec11b858112945ad9d75b310260b95910a17ce81",
      "parts": [
        "قتالا يضرم النار في عروقي."
      ]
    },
    "MID_EV12_001_m01_036": {
      "source_sha256": "c0909f52e34cca413304bfb0637a94b079230a9b44374b817d4d739f678be107",
      "parts": [
        "قتالا تريد؟ يقولون إن في داغدا نفسها حلبة هائلة."
      ]
    },
    "MID_EV12_001_m01_037": {
      "source_sha256": "6a9b34464d0a0fb24f4b8d5fda65ae54b55cee6d4a742cc542db22668becd495",
      "parts": [
        "وقد بلغني أن بطولة ستقام فيها وتدوم أشهرا."
      ]
    },
    "MID_EV12_001_m01_038": {
      "source_sha256": "15e99ac72a6e7725cc425de0cc0bf04468741387bdabbd105a7360b09c465115",
      "parts": [
        "وها هم خيرة المحاربين يتوافدون عليها من كل أرض."
      ]
    },
    "MID_EV12_001_m01_039": {
      "source_sha256": "246cf6eac1c5d1a826932cf2028f6a0792711a586ef42a72e53fffd6e5756f54",
      "parts": [
        "أحقا؟ ذاك خبر يسرني."
      ]
    },
    "MID_EV12_001_m01_040": {
      "source_sha256": "0ae600022e7b5ae10680d053478756e5f7f4e3976830fdd688025b95ee61228a",
      "parts": [
        "ما أنت إلا وحش ضار. ومثلك مثل النخبة\nالعشرة من قبلك، لا يحركك سوى شهوة القتال."
      ],
      "flow": "auto"
    },
    "MID_EV12_001_m01_041": {
      "source_sha256": "c0861759cdf66d43a9b85c2488f7630254fdf562ca79eb4409502518efdf2058",
      "parts": [
        "تسوقك أحط الغرائز: الظمأ إلى الدم. ما أبعد ما بيني وبينك..."
      ],
      "flow": "auto"
    },
    "MID_EV12_001_m01_042": {
      "source_sha256": "33b8a9972ce00820c4bf01524358f41c904b5041cdb197b3863512dad95dea1b",
      "parts": [
        "ومع ذلك، لك علي شكر لأنك أنقذتني. دعني أدلك على الطريق."
      ]
    },
    "MID_EV12_001_m01_043": {
      "source_sha256": "81ecfec634e34f609f27e323c733bdb7ce1e2662ca95bc110c90240a7dca44c5",
      "parts": [
        "لا تحكم علي بمظهري. في جعبتي من الحيل ما يكفيني."
      ]
    },
    "MID_EV12_001_m01_044": {
      "source_sha256": "e7ec87a90bd26d7f92e95080bb49b4fc167341bb1622158744a95f0f8a8191f2",
      "parts": [
        "لكن رجلا مثلي لا بد أن يعاني تحت هذه الشمس القاسية. ما أبغضها!"
      ]
    },
    "MID_EV12_069_m01_001": {
      "source_sha256": "4df8dfa0ec3b40e6c90bfabc29cca0deac9cde38666e97a60ca9d8c0682d8f60",
      "parts": [
        "أعرف تلك القوة. أو قوة تشبهها... إنها قوة الإلهة!"
      ]
    },
    "MID_EV12_069_m01_002": {
      "source_sha256": "8dafc32c553aed1a869c0a3ae0008f242611b870ad5b8476c1d94ca83e3d76a2",
      "parts": [
        "زيك من زي أهلنا، لكن قوة تلك البهائم\nتسري في عروقك. ما أنت إلا مسخ."
      ]
    },
    "MID_EV12_069_m01_003": {
      "source_sha256": "d0ce753e1289a291b9966a651b3ed83536945a810c7129a01cc21d095567be41",
      "parts": [
        "مـ... ما اسمك؟"
      ]
    },
    "MID_EV12_069_m01_004": {
      "source_sha256": "5fbb9f1a50c00cba0c1ff188baf77b7e7a3b67ec93586efa846d26250dd3fb66",
      "parts": [
        "ما أسرع يدك إلى السيف! لكن لا بأس.\nإنما جئت لأدلك على الطريق."
      ]
    },
    "MID_EV12_069_m01_005": {
      "source_sha256": "d6260acae9d28a4a11cb036841160b20864b1e972f65e406c989e7fd01d85cc2",
      "parts": [
        "نهبك الرمل الإلهي. وما دام معك فلن أفارقك حقا."
      ]
    },
    "MID_EV12_069_m01_006": {
      "source_sha256": "0d8c32bd85a3a8824a70c1db201107f7e8f3fcbb833153cac4f87f5877e4db0f",
      "parts": [
        "يا لوقاحته! لقد هم بقتلي!"
      ]
    },
    "MID_EV12_069_m01_007": {
      "source_sha256": "affa9c9213cfe13f4f612c6b5401be45ee6be61c613b25f3d0688c2c6a63c160",
      "parts": [
        "لولا وجودك هنا لشطرني نصفين!\nوهذه آخر مرة أتدخل فيها من أجله!"
      ]
    },
    "MID_EV12_069_m01_008": {
      "source_sha256": "9f228e027667c65923904967820bd9e5ba00aecffbbd3cfdca251783af1bb6cc",
      "parts": [
        "ما الذي كان ذاك؟"
      ]
    },
    "MID_EV12_069_m01_009": {
      "source_sha256": "0ec35f8deabc1427f9e627edfd3a2ce25219f8f7b6f9b3664f02df6589b6b59d",
      "parts": [
        "روح من أرواح داغدا. كائن يعجز فهمنا عن إدراكه."
      ]
    }
  }
}
