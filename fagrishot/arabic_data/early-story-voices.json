{
  "0_ISM_c02.msbt.zst": {
    "MID_EV00_006_m01_001": {
      "source_sha256": "f8237f11933af0a265d63d93331a6b47b273d182c4e01b861051ff07f46376ea",
      "parts": [
        "ها قد وصلنا. لنصعد إلى السطح،\nومن هناك نمضي إلى داغسيون."
      ]
    },
    "MID_EV00_006_m01_002": {
      "source_sha256": "38837fe2d0cc48f86ef28afefb1d540f655b69e6201943d192776751fcbc56d4",
      "parts": [
        "ما هذا المكان؟"
      ]
    },
    "MID_EV00_006_m01_003": {
      "source_sha256": "3b80fe35d515b9ce976a02b2344000f4a18538bb092d54f85a6ebfb8076aa5e5",
      "parts": [
        "لا أعرف عنه الكثير، لكنني سمعت أن عمره آلاف السنين."
      ]
    },
    "MID_EV00_006_m01_004": {
      "source_sha256": "59c28343edf04a6fca2cf34d27e80fb8e90f653c8071e27c736ed239d6b577ed",
      "parts": [
        "يوم وقع الانهيار العظيم، محيت من على السطح\nمعظم آثار الحضارة التي كانت قائمة آنذاك."
      ]
    },
    "MID_EV00_006_m01_005": {
      "source_sha256": "9d8486ef3b49365b500fdc5d56c17e7afe6655ea377621c44d97f89217b10c49",
      "parts": [
        "أما بعض المنشآت التي شيدت تحت الأرض فنجت،\nومنها ما لا يزال يعمل إلى اليوم."
      ]
    },
    "MID_EV00_006_m01_006": {
      "source_sha256": "52c0ebe6216ef72b6aca31776317622d82aef8dbb5b1a258ac3dd9c755f0caa0",
      "parts": [
        "هذا مذهل."
      ]
    },
    "MID_EV00_006_m01_007": {
      "source_sha256": "868d4e641fa517b1585e4d2ded47d60cf872adb88d65474fd5a8614509e35f49",
      "parts": [
        "ماذا كانوا يفعلون هنا؟"
      ]
    },
    "MID_EV00_006_m01_008": {
      "source_sha256": "457ed9602569ab5e075d1fc763e30c8aedd9001150da9d5254aa86a905700d78",
      "parts": [
        "الحق أنني أنا نفسي مذهولة مما استطاعوا صنعه قبل الانهيار العظيم."
      ]
    },
    "MID_EV00_006_m01_020": {
      "source_sha256": "808a73e2a3366ba7f978fdf90a343ba20dae592f11bef983d46d7a86674c4ace",
      "parts": [
        "صنعوا أجزاءه بحيث لا تبلى. كانوا يتوقعون\nأن يظل في الخدمة عشرة آلاف سنة."
      ]
    },
    "MID_EV00_006_m01_009": {
      "source_sha256": "6266aadf07dd0356db8ec07e868e1beac43385e881850c44e81330bfb1a91b80",
      "parts": [
        "أحسبه كان مرصدا يراقبون منه بحر النجوم."
      ]
    },
    "MID_EV00_006_m01_021": {
      "source_sha256": "7a33cd1252032fd541d9c88b59d4e714956609eac5f6ef461f91662ffe60cd38",
      "parts": [
        "ويقال إن العالم القديم كان يعج بأماكن كهذا."
      ]
    },
    "MID_EV00_006_m01_011": {
      "source_sha256": "a7500736ae477c97a08b752017967a7603aff3d88e2123824c39f99a8b0a9b74",
      "parts": [
        "أما اليوم... فلا يكاد أحد يعرف حتى بوجود هذا المكان."
      ]
    },
    "MID_EV00_006_m01_012": {
      "source_sha256": "96fc5a915eb1c4f71790305c55b6b9ed71eebd35a11bb211c5988ab1643c12c5",
      "parts": [
        "ولو حاول أهل زماننا أن يبنوا له نظيرا، ما استطاعوا."
      ]
    },
    "MID_EV00_006_m01_013": {
      "source_sha256": "1123106b6f11cf6eca6e833179fe0b85361dac29059f39f461f3cb3c3f398e00",
      "parts": [
        "لعل ذلك مصير كل حضارة بادت.\nتبهت ذكراها شيئا فشيئا، حتى ينساها الناس."
      ]
    },
    "MID_EV00_006_m01_014": {
      "source_sha256": "ac453c343ecb981863419369216c407a7bf1abaaf5e1c9b7daf7f72114b884a1",
      "parts": [
        "كان داغدا العظيم يخشى كل ما خلفه\nالعالم القديم، وأراد أن يمحوه عن آخره."
      ]
    },
    "MID_EV00_006_m01_015": {
      "source_sha256": "1fcdbf3deccc1fdc7328f0c1fd11a57e4669ab7b8ad0d08f87f851d591c3beb0",
      "parts": [
        "والآن إذ أستعيد ما جرى... لهذا بالذات قامت معركة فزان."
      ]
    },
    "MID_EV00_006_m01_016": {
      "source_sha256": "3267d890767216a1a5da7370e58858b1b6510c871ae51c47bbca994789c25504",
      "parts": [
        "آه..."
      ]
    },
    "MID_EV00_006_m01_017": {
      "source_sha256": "386c051e0594798bf7b56ff7dea2e06125af29cd4050aa79e2aa9818051d9624",
      "parts": [
        "هل أنت بخير؟"
      ]
    },
    "MID_EV00_006_m01_018": {
      "source_sha256": "c4ab6380381a19104a0417436a48897cea20836ba985b44ab6fb34ec9720114b",
      "parts": [
        "نعم... أنا آسفة. لا، ليس بي شيء."
      ]
    },
    "MID_EV00_006_m01_019": {
      "source_sha256": "8e5aa4fe03732c43bcde6a40d7a4bbd4fed62d5623d4a17ef8423ae543313cb5",
      "parts": [
        "لا أدري ما الذي حملني على البوح لك بهذا كله."
      ]
    },
    "MID_EV00_008_m01_001": {
      "source_sha256": "9524669369d59489c585c8d13e0e60ee5435e4d3086e21248831a6c9bd052142",
      "parts": [
        "من هنا لم يبق بيننا وبين داغسيون إلا القليل."
      ]
    },
    "MID_EV00_008_m01_002": {
      "source_sha256": "6b73531b52a57263b2ea838740758cc43acdb00bd287bd685975da3cccea6297",
      "parts": [
        "لكنني لا أدري ما الذي ينتظرنا اليوم داخل أسوارها."
      ]
    },
    "MID_EV00_008_m01_003": {
      "source_sha256": "b68867d8df2453577e0aa6dc543f85e015d67d095365e70fe05ba6a1fc42741f",
      "parts": [
        "وفيها بوابة للعالم السفلي...\nفلا بد أن الموتى العائدين يعجون بشوارعها."
      ]
    },
    "MID_EV00_008_m01_004": {
      "source_sha256": "0c6d3b0b7711e715526620e5bafd13930ee577c1d68669cec5da68ed3e7b5563",
      "parts": [
        "هم جميعا، وليس معنا أحد سوانا... حتى معك، لا أرى لنا حظا يذكر."
      ]
    },
    "MID_EV00_008_m01_005": {
      "source_sha256": "91e2ff7c76a457369d0d9eda1859dfedee60c9ef185d7a8686acdc6708d40167",
      "parts": [
        "سنشق طريقنا من بينهم."
      ]
    },
    "MID_EV00_008_m01_006": {
      "source_sha256": "6e7adaec1a4d8f881c83b94995338b7b91263f47ab1518646e3ef6a1582ebeb1",
      "parts": [
        "أجل، موقفنا لا يطمئن."
      ]
    },
    "MID_EV00_008_m01_007": {
      "source_sha256": "a90ba704a5c5a84ad57f2fd8f5c99a0c5a27a4c0ac859a6eca320c08fddd2834",
      "parts": [
        "هه. ما بالي أصدق أننا سنغلبهم لمجرد أنك قلتها؟"
      ]
    },
    "MID_EV00_008_m01_008": {
      "source_sha256": "07fd0123c11ff1f8828b5c03f3f7a01a807f54ce0184ddb4c8c4e85d6782b9eb",
      "parts": [
        "ما أعجب أمرك."
      ]
    },
    "MID_EV00_008_m01_009": {
      "source_sha256": "b6808da05e5814ac7776a33b0521ce1898cce113bc406a28a1f2ac2ab3049932",
      "parts": [
        "لا... لا يهم. وأي خيار آخر أمامنا؟"
      ]
    },
    "MID_EV00_008_m01_039": {
      "source_sha256": "ffb27b66e30d61ca38d79d7e9967c49805927c2819f4409813f12b5601d9059e",
      "parts": [
        "علينا أن نصل إلى معبد فورتونا رأسا وننضم إليها هناك."
      ]
    },
    "MID_EV00_008_m01_010": {
      "source_sha256": "a982a944d2873752fbabd1fbe9004ea8dcc332ef65fd6bedfba09889cc1cff45",
      "parts": [
        "ها قد جئت أخيرا يا هونغ هوا. لقد طال انتظاري."
      ]
    },
    "MID_EV00_008_m01_011": {
      "source_sha256": "04e99c1e47999781931cf6693a853f394bcc793f77e3298420b168b7db12cbdd",
      "parts": [
        "تروي! ما الذي جاء بك إلى هنا؟!"
      ]
    },
    "MID_EV00_008_m01_012": {
      "source_sha256": "070a77eff97d43f887d3236b01d0e4f27f5417583e0b144d415b0d898228379e",
      "parts": [
        "اتصل بي زينون قبل مدة وطلب مني أن أساعدك."
      ]
    },
    "MID_EV00_008_m01_013": {
      "source_sha256": "1cd8b828bfc95e206215dfbb8d17f0c28db6996eb8857f796e3bfaa089163a41",
      "parts": [
        "لا أظنني أعرفك."
      ]
    },
    "MID_EV00_008_m01_014": {
      "source_sha256": "17efadfe79373baa845d5ff9304f5f023a43fe635425fe22ae24fca46c19ff9a",
      "parts": [
        "هونغ هوا، من هذه؟"
      ]
    },
    "MID_EV00_008_m01_015": {
      "source_sha256": "af13715138d1c9c1d78543bd9fe6c3c07cc02606c2fd8a6d7836b345fdbcedde",
      "parts": [
        "آه، صحيح. إن أردنا الدقة، فهذا أول لقاء بيننا."
      ]
    },
    "MID_EV00_008_m01_016": {
      "source_sha256": "e6624685664582d8ef0ffe18fc864c1ef477fb912088442be68e694156a64737",
      "parts": [
        "هذه تروي، وهي أيضا من نوا. كانت نائبة معلمي زينون هناك."
      ]
    },
    "MID_EV00_008_m01_017": {
      "source_sha256": "58399e63f7df96818d5b44baa92c4fa4b2a5de6d02a27af15ac6f2986895cc60",
      "parts": [
        "ولهذا سأرافقكما من هنا."
      ]
    },
    "MID_EV00_008_m01_018": {
      "source_sha256": "b920c563671c243b8ea59c55e96dca8f175f61ac1a57d9f66095098ef89ec91e",
      "parts": [
        "يا لك من شاب وسيم! حتى في مثل سني،\nأخشى أن يقع قلبي في هواك."
      ]
    },
    "MID_EV00_008_m01_019": {
      "source_sha256": "59b39b2775c76d5e4d9a1a014aeb7532372ddbb1426e3c22ec71d11823240020",
      "parts": [
        "ويا لك من شابة جميلة! تذكرينني بنفسي أيام الصبا."
      ]
    },
    "MID_EV00_008_m01_040": {
      "source_sha256": "856302950c457b363bfd9b5d71da1c12aa5f4af46c69b4ddaa6fe01ad914f64a",
      "parts": [
        "تروي، يؤسفني أن أقول لك هذا، لكن... معلمي زينون لن يعود."
      ]
    },
    "MID_EV00_008_m01_041": {
      "source_sha256": "109f5d00f68ec13e25d35cc3849eb712f4f43e3a9f8d72ba6e7687497b962b8b",
      "parts": [
        "أعرف. وأنا واثقة أن آخر أعمال زينون أدخل السرور إلى قلبه."
      ]
    },
    "MID_EV00_008_m01_029": {
      "source_sha256": "213022d5ea35173f09ed4574255663234fa83cd0ac471a5d2e13664297d9fb24",
      "parts": [
        "وعلى ذكر آخر أعماله... ليست المهمة\nالتي عهد بها إليك بالهينة، أليس كذلك؟"
      ]
    },
    "MID_EV00_008_m01_030": {
      "source_sha256": "03ef17ccb3046e4e51a2c1dbfca76ec4561f8ee62a5612196adad0340aa562ae",
      "parts": [
        "أخبرني زينون بها. إنقاذ العالم بأسره! ما أوسع طموحك!"
      ]
    },
    "MID_EV00_008_m01_032": {
      "source_sha256": "241f453501ad0c56646676580d25724e3a6c3b7d46c4f3533b659f38aeb147de",
      "parts": [
        "وها أنا هنا. أثارت المهمة فضولي فجئت لأعينك."
      ]
    },
    "MID_EV00_009_m01_001": {
      "source_sha256": "d0cc8500408c30e29c3545280f3f3955e2940f2bad8fcd41cb255cfe200f01c4",
      "parts": [
        "أما كان ينقصنا إلا هذا؟! ليند هنا!"
      ]
    },
    "MID_EV00_009_m01_002": {
      "source_sha256": "1f6984f708a864ab7a14b9c23958c8634bdf616d06ce0e3e4ac88690a44a9ded",
      "parts": [
        "أذكرك... كنت تجرين في أثر المعلمة راكشا،\nوتعضين أعقابها كجرو تائه."
      ]
    },
    "MID_EV00_009_m01_003": {
      "source_sha256": "b85f1cd95a212aad0ac786c5b80eb6cced7a96ced6c3a87fafa3b39ced0f1d21",
      "parts": [
        "وما إن طردتك حتى وجدت لنفسك سيدا آخر."
      ]
    },
    "MID_EV00_009_m01_004": {
      "source_sha256": "1bb231ad0ceec1d3e8e16d8d64892efc54059ebd32b271caa4f9b67e3b32e605",
      "parts": [
        "ما أنت إلا كلبة شاردة تتبع كل سيد يطعمها... يا لك من بائسة."
      ]
    },
    "MID_EV00_009_m01_005": {
      "source_sha256": "8ccfbb718ab3c1532e4cda7ede63b216453281940b4de10fa887f3b97ea0e1a8",
      "parts": [
        "أرى أن الموتى العائدين ما زالوا ينطقون.\nفاسمع ما أقول: ابتعد عن طريقي."
      ]
    },
    "MID_EV00_009_m01_006": {
      "source_sha256": "d9014bc7753fa67449df3bbe437ad392e6be74046f4ecfae463c3110d26f349d",
      "parts": [
        "لم نأت في طلبك. تنح قبل أن تندم."
      ]
    },
    "MID_EV00_009_m01_007": {
      "source_sha256": "af67b38f91ab60f6c4b55d707cfda21fdebe4c355e1b33398048935878b067c9",
      "parts": [
        "بأمر من مولاي بالور، لا يجوز لأحد عبور هذا المكان."
      ]
    },
    "MID_EV00_009_m01_008": {
      "source_sha256": "a7a44be114f9c837f035a686b0330e126c6f17b55e239a0eb07d626d26ba85ef",
      "parts": [
        "سينكشف لكم حمقكم حين تذرو الرياح أشلاءكم،\nشأن هذه الجثث من قبلكم."
      ]
    },
    "MID_EV00_009_m01_009": {
      "source_sha256": "af3add8146272d59c24391d63195bfe311419e31910ab84663d4cbc67c05f19b",
      "parts": [
        "لكن لا تخافوا... ففي الموت خلاصكم."
      ]
    },
    "MID_EV00_009_m01_013": {
      "source_sha256": "8ccf6e8309ab8ed1c9b36bdd9b0be340adbe76ec04ef3098323c3a8a3f68743f",
      "parts": [
        "كنت مرعبا حتى في حياتك، لكن كان فيك يومئذ ما يأسر الناس."
      ]
    },
    "MID_EV00_009_m01_014": {
      "source_sha256": "05cf324c362da4d6bbbdb506d8f0b10ce493bc76ff40e44a3b0121b12b92b1ca",
      "parts": [
        "انبحي ما شئت أيتها الكلبة. أما أنت... فلا أذكرك. من أنت؟"
      ]
    },
    "MID_EV00_009_m01_015": {
      "source_sha256": "4a88cdcb21dce8ef378e0e0615a7a0a19af12de3688d2e0faeee718e5b44bb84",
      "parts": [
        "(أتحدى ليند بنظرة)"
      ]
    },
    "MID_EV00_009_m01_016": {
      "source_sha256": "ef3b44e0e06f6f3e7a79cd2cd1067292e97a54dfa5eddf2f2ff6ec6d36a0eaa1",
      "parts": [
        "لا أحد."
      ]
    },
    "MID_EV00_009_m01_017": {
      "source_sha256": "3ead6bce2a9f8dcf65900dd2df68b180563e7f6502983c9f6ff7b8596ff47581",
      "parts": [
        "فيك شيء أمقته من أعماقي... ولا أدري لم."
      ]
    },
    "MID_EV00_009_m01_018": {
      "source_sha256": "74982f88d0ea1771e663687a7ee1848d382d38a57fc534959d38fc7d2c8720fb",
      "parts": [
        "أي سخرية هذه؟ سيسرني أن أخيط شفتيك بعد موتك."
      ]
    },
    "MID_EV00_009_m01_019": {
      "source_sha256": "3e56bc4b4360645af0a91465cdbf2bc95691e6283b3c8644cc43dcfa31258011",
      "parts": [
        "ورمحك هذا غريب أيضا..."
      ]
    },
    "MID_EV00_009_m01_020": {
      "source_sha256": "1c13a7ac53db6561a472e1ce52310c24b7d1561e69e43e637f0cb1c601ea3a4f",
      "parts": [
        "يكاد الاسم يحضرني... أيمكن أنك..."
      ]
    },
    "MID_EV00_009_m01_021": {
      "source_sha256": "3262f20db9c01ad63b9ea9c2dcada56b237024579416eb5b2b0664f20c7d4738",
      "parts": [
        "لا... ما زلت لا أذكرك.\nلكن إصرارك على مواجهتي لا يخفى علي."
      ]
    },
    "MID_EV00_009_m01_022": {
      "source_sha256": "e9bbf592c233c29cea39c4e2f1fbc46948b4e919be70cd2d6b8ff1b8e87e81e7",
      "parts": [
        "فليكن. هنا ستكون نهايتك،\nوسينضم جثمانك إلى غابة الجثث التي أقمتها."
      ]
    },
    "MID_EV00_009_m01_023": {
      "source_sha256": "b634f211fe2c705709d19fc97b7a69be0679a2d1e08f0c52090c244577968ad8",
      "parts": [
        "وأهدي أرواحكم إلى مولاي بالور."
      ]
    },
    "MID_EV00_010_m01_001": {
      "source_sha256": "4bdfabc6b3a71c11526ae195da8611b538959e1e70f1d09503dd00792d62fd4e",
      "parts": [
        "مستحيل... معي قوة العالم السفلي. ما كان لأحد أن يهزمني!"
      ]
    },
    "MID_EV00_010_m01_002": {
      "source_sha256": "2d151279b6579594e7ecc9f88e55ba4d3415641581039d4185c47fc66d207f4f",
      "parts": [
        "من أنت؟ يستحيل أن يجري في عروقك دم البشر..."
      ]
    },
    "MID_EV00_010_m01_003": {
      "source_sha256": "a874ff1b8a6259c83a7037ffe16d67ba820d0ac63bebb7bf42e77c65771fbc53",
      "parts": [
        "آه! هاها... إذن أخطأنا جميعا\nحين حسبناك في عداد الموتى."
      ]
    },
    "MID_EV00_010_m01_004": {
      "source_sha256": "00656188042e223eee3e05ee1c31a6ad7733342c4fa7070633bedc8da11be8e9",
      "parts": [
        "هاها! ها... يا لها من طرفة!\nما ظننت يوما أن يحدث شيء كهذا حقا."
      ]
    },
    "MID_EV00_010_m01_005": {
      "source_sha256": "b8eb63650328634843aeef789a488746fa6e9689aaf428f502e5ca4e58984132",
      "parts": [
        "ومع ذلك... لم أهزم بعد."
      ]
    },
    "MID_EV00_010_m01_007": {
      "source_sha256": "92aa2a8e23fc057e55a626a8345f33479400d41e97d6b5bebe04878b8b3f3851",
      "parts": [
        "لعلكم خمنتم من يحرس بوابة العالم\nالسفلي في داغسيون. لن تغلبوه أبدا."
      ]
    },
    "MID_EV00_010_m01_009": {
      "source_sha256": "e0be89645f7bd69c525fbe3e813d45dc7362510907d5386fc74e408a3dd14099",
      "parts": [
        "هاها... هه... عسى أن تهيموا معا في دركات اليأس."
      ]
    },
    "MID_EV00_010_m01_010": {
      "source_sha256": "489463404e43c235f03028180b0dfc89f6f91308966537aa8a9377ccd2b33e26",
      "parts": [
        "ما من شيء أحب إلى بالور من يأس الأحياء... فاجتهدوا... في إرضائه."
      ]
    },
    "MID_EV00_010_m01_014": {
      "source_sha256": "bbfef4b5bb8b71f17294d0891fc442b4cec97fa8e0fde1fba697a0ce0ab41e48",
      "parts": [
        "كفى. عد زاحفا إلى قبرك."
      ]
    },
    "MID_EV00_010_m01_016": {
      "source_sha256": "59b5d7a716d0b6d717e560104f12cbd2afd0c263e253264cfb30d2b67f1fcb14",
      "parts": [
        "هاهاها! لن يطول الوقت حتى تلحقوا بي.\nألقاكم في العالم السفلي."
      ]
    },
    "MID_EV00_010_m01_017": {
      "source_sha256": "87bdb37ed715efcfe66baac90dbac9f6878107493553f46ec7adb16a4b78548b",
      "parts": [
        "هيه هيه... هاهاهاها..."
      ]
    },
    "MID_EV00_010_m01_018": {
      "source_sha256": "8b466104f1d7b2915dc701968e4642f2da53a8d22583807ec345156469b68810",
      "parts": [
        "كان يرعبني وهو حي، فإذا به بعد موته أشد رعبا."
      ]
    },
    "MID_EV00_010_m01_019": {
      "source_sha256": "09c1b7ce1a60c9edeea93519e0bc2121c9eb99f7648264db20173492d91652bd",
      "parts": [
        "لا سبيل إلى عيش يجمع الأحياء والموتى.\nومحاولة إقناع الموتى مضيعة للكلام."
      ]
    },
    "MID_EV00_010_m01_020": {
      "source_sha256": "6bd645d359bde5599588e820dde86be4a3c51e0db89ddf870e47e7c9c74091ad",
      "parts": [
        "لكن كلماته الأخيرة أقلقتني. ترى ما الذي عناه بها؟"
      ]
    },
    "MID_EV00_011_m01_001": {
      "source_sha256": "74b761d14afb00514030124bb21a5b7a0573ff88424e2bc8f53c0a59bbe3fc11",
      "parts": [
        "تروي... أكان كل ذلك ضروريا؟"
      ]
    },
    "MID_EV00_011_m01_002": {
      "source_sha256": "8ae249cc4d067ec330a47c410905c808be3f532be241a46ea5ae9c030eca52a6",
      "parts": [
        "رجل كهذا لا يدخل شيء في رأسه إلا بضربة كهذه."
      ]
    },
    "MID_EV00_011_m01_003": {
      "source_sha256": "b87addd542f389a03a84eb9756343c8584fef8ad5c1af3557ed3f0df993288a8",
      "parts": [
        "سعيدة برؤيتك مجددا يا فورتونا. وها أنا مدينة لك بجميل آخر."
      ]
    },
    "MID_EV00_011_m01_007": {
      "source_sha256": "81e43e09c9939469e0a022795c6d6bc1a61eedc7d99c66edb9181f25856db611",
      "parts": [
        "جئت لاستقبالك، فإذا بي أنقذك!\nكيف وقعت في ورطة بهذه السرعة؟"
      ]
    },
    "MID_EV00_011_m01_008": {
      "source_sha256": "961bf725056978a25ca92ae08614a8edf157e8398258914e460baa853fdb007f",
      "parts": [
        "حذار من مثل هذه الغفلة. فلولاي لفقدت حياتك."
      ]
    },
    "MID_EV00_011_m01_009": {
      "source_sha256": "b4304a645cae1e17937965823ec0d9da93a9b7718a761130cec227c1d079bdcf",
      "parts": [
        "أعتذر."
      ]
    },
    "MID_EV00_011_m01_010": {
      "source_sha256": "409f079010c4c24effef570303ab0d8cf181f4762cf95cf353b2bba5b40fb8e1",
      "parts": [
        "كنت أعلم أنك ستنجديننا."
      ]
    },
    "MID_EV00_011_m01_011": {
      "source_sha256": "1164b2133a80f54b89b97537976a590bcc0d0b84949ceebe18bbec950e08eb1a",
      "parts": [
        "آه، ما أطيب هذا التواضع! يبدو أن فيك أملا بعد."
      ]
    },
    "MID_EV00_011_m01_012": {
      "source_sha256": "c816b9a7ef88dee4b118808a80c11dcc29aac4b3af29429ef3abb47146e95a3b",
      "parts": [
        "والحق أنك اليوم أحب إلي بكثير مما كنت أول مرة. هيه هيه."
      ]
    },
    "MID_EV00_011_m01_013": {
      "source_sha256": "a88c89e73155759e30df68d24f64d18c2002a9979ec48476856ec8775dcd9a0d",
      "parts": [
        "همف! وما هذا إلا تنصل منك من واجب الدفاع عن نفسك."
      ]
    },
    "MID_EV00_011_m01_014": {
      "source_sha256": "7f486c739e4ec65614f5459eb84cd404a3152c7a5723bdfd912304e74bf70944",
      "parts": [
        "لست حارستك الخاصة. ولا أرضى\nأن تصبح حمايتي لك حقا مفروغا منه."
      ]
    },
    "MID_EV00_011_m01_015": {
      "source_sha256": "2453d4bccb755d69764add6b3806c08e93203b4a9bafb46706855aaea1483e69",
      "parts": [
        "ألم تقولي إنك ستنتظريننا في معبدك؟"
      ]
    },
    "MID_EV00_011_m01_016": {
      "source_sha256": "5c920a290035608ac9bab0ac60cf32a5319e32d126eea85c08aa60e0a70dc29d",
      "parts": [
        "بلى، لكن شيئا حدثني بأن وراء\nالأمر متاعب. وحسنا فعلت إذ جئت."
      ]
    },
    "MID_EV00_011_m01_017": {
      "source_sha256": "e4a97b53def794f52e30c5aeeb030b9d5621ee34a7377ffb3dafc7e19d47870c",
      "parts": [
        "على أنني أعددت لك هذا في انتظارك.\nوآمل أن ألقى منك ما أستحق من امتنان."
      ]
    },
    "MID_EV00_011_m01_018": {
      "source_sha256": "cd1956b0716bc925fb3664ab8f4b6bd198cbdc8dfa020f7668d4582e6765a7de",
      "parts": [
        "ما هذا؟"
      ]
    },
    "MID_EV00_011_m01_019": {
      "source_sha256": "74b0cb1bc1da567c56ac962b90dc3c03b005e0e4222f7498b72b27105d9b7f07",
      "parts": [
        "يشبه الرمل، لكنه أبعد ما يكون عن حفنة رمل.\nففيه أودعت بعض قوتي."
      ]
    },
    "MID_EV00_011_m01_020": {
      "source_sha256": "7727bcc163d97a7c8c61fc440f76115339f8035dad5bf1eab937e1a9e564cb7f",
      "parts": [
        "سأسميه... الرمل الإلهي."
      ]
    },
    "MID_EV00_011_m01_021": {
      "source_sha256": "11b616df64964b904709fc12e2dfa4defcded92ff44002d2e0af4f368302a63d",
      "parts": [
        "بهذا الرمل تصبح قوتي في متناولك\nأنت أيضا... أقصد، قوة الإلهة الأم."
      ]
    },
    "MID_EV00_011_m01_022": {
      "source_sha256": "544e9cf7adf11a1bf153529b08a4d3287d8e92c78159a9e5fba45e926b9cac8c",
      "parts": [
        "يرد هذا الرمل الزمن إلى الوراء، كما رأيت."
      ]
    },
    "MID_EV00_011_m01_023": {
      "source_sha256": "b91f483b1f328b59106b1750b65a23a3339e1876398e58c7ed83988ea88d6222",
      "parts": [
        "هذا لك. فقد ينقذ حياتك يوما في المعركة."
      ]
    },
    "MID_EV00_011_m01_024": {
      "source_sha256": "9616056e46fc2609883cc784c955f318a98706d0f1f6b89da52c13ee228486b9",
      "parts": [
        "واستعماله يقتضي حكمة.\nفقوتي أعز من أن تهدر عند كل سانحة!"
      ]
    },
    "MID_EV00_011_m01_025": {
      "source_sha256": "d7a504550593f0a0e70129d806850ae31bb36b61604f8550324a4635fb904377",
      "parts": [
        "ما خطوتنا التالية يا فورتونا؟\nأنحطم بوابة العالم السفلي في داغسيون؟"
      ]
    },
    "MID_EV00_011_m01_026": {
      "source_sha256": "2d1555796ef6caf073e80f1a67bee18b30c2c88aa2618e2504be274229ab9084",
      "parts": [
        "رأي سديد... لو لم تكونوا هذه الحفنة القليلة."
      ]
    },
    "MID_EV00_011_m01_027": {
      "source_sha256": "81e4c4a527f63bd0bb1b3b1fcf2dc8548025f975362f407363fa63c6b4bbc420",
      "parts": [
        "نحن بهذا العدد لا أمل لنا في قتال جند بالور. همم..."
      ]
    },
    "MID_EV00_011_m01_028": {
      "source_sha256": "acbabca60384ebd46f967996afbd995c344fb025ea528f9dd7b4714dd594c7d7",
      "parts": [
        "لو صار عدد جندنا عشرة أضعاف ما هو عليه،\nلكان لنا في القتال بعض الأمل."
      ]
    },
    "MID_EV00_011_m01_029": {
      "source_sha256": "fbc61f3f58c2b73696ec0be383abee32dd1ce76229d722d650d49c9914287ebe",
      "parts": [
        "ومن أين لنا في هذا الخراب بكل أولئك المقاتلين؟"
      ]
    },
    "MID_EV00_011_m01_030": {
      "source_sha256": "1650e1986781af1c7187e34a9d2e853361c24b81229add1ba60ad77363a5c95e",
      "parts": [
        "ها! لن تجدوهم هنا! ومع ذلك ثمة سبيل.\nوقد مهدته لكم بنفسي."
      ]
    },
    "MID_EV00_011_m01_031": {
      "source_sha256": "ee208005c47ff33c9acc326ad8f5050f0bda9340fe138bcee5e711fbece7572d",
      "parts": [
        "أحسبتم أنني أمضيت الوقت كله أغفو؟"
      ]
    },
    "MID_EV00_011_m01_032": {
      "source_sha256": "8d3f7bedd23575183fae16207b9815e245da8aaa886ba27a1b6287c3d0e4b4bd",
      "parts": [
        "اتبعوني أبين لكم الأمر."
      ]
    }
  },
  "0_ISM_c03.msbt.zst": {
    "MID_EV00_012_m01_001": {
      "source_sha256": "7a1e56a1f0d57419bdf4c2ff5bc711b526d5f363a775b73341e62899781b8364",
      "parts": [
        "ها قد وصلنا."
      ]
    },
    "MID_EV00_012_m01_002": {
      "source_sha256": "d615be7993f41c84aa43ea8869f18be5c8d18dbcf41743bec1243b9d72b46375",
      "parts": [
        "غريب... نحن في قلب داغسيون، ولا أثر هنا للموتى العائدين."
      ]
    },
    "MID_EV00_012_m01_003": {
      "source_sha256": "e3c42819d2a7698e6bafeacd739b32aa5cb93dbd70f07ba28673c29811cdf34f",
      "parts": [
        "هذا إن كنا في داغسيون حقا. أكاد أشعر أننا خارج هذا العالم..."
      ]
    },
    "MID_EV00_012_m01_004": {
      "source_sha256": "38837fe2d0cc48f86ef28afefb1d540f655b69e6201943d192776751fcbc56d4",
      "parts": [
        "ما هذا المكان؟"
      ]
    },
    "MID_EV00_012_m01_006": {
      "source_sha256": "74d772bddedb5c922c8eaca312f9decae3e25057c39217a08b93b3181421f043",
      "parts": [
        "قاعة لا شبيه لها. سميتها قاعة المسلة."
      ]
    },
    "MID_EV00_012_m01_008": {
      "source_sha256": "7688de6e99b0cec7f78c0e6b77e0ede5c7bafb412b984923f167478df38e8ef6",
      "parts": [
        "قلة هم الذين يعلمون بوجود هذه القاعة تحت معبدي."
      ]
    },
    "MID_EV00_012_m01_009": {
      "source_sha256": "c5e60ca291b8938a5fef390ec92e2557cb7c8c3db38840edb4635213d70a05d4",
      "parts": [
        "كانت هي من طلبت إلي أن أهيئها،\nتحسبا لكارثة تحل بهذه الأرض."
      ]
    },
    "MID_EV00_012_m01_018": {
      "source_sha256": "06d3c4b180be9be03bdbece5cbc200d22109ac303d97944aef047bf9767101fc",
      "parts": [
        "أنا إلهة القدر. ومن نعم هذا المقام\nأنني أستطيع أن ألمح ما يأتي به الغد."
      ]
    },
    "MID_EV00_012_m01_019": {
      "source_sha256": "eee96916d6da45b8a96a1c8a30649268906d9b91aba9710111eece3f4c091d5a",
      "parts": [
        "وقد شهدت في إحدى رؤاي خللا مروعا\nيضرب صلة الأسباب بنتائجها في هذه الديار."
      ]
    },
    "MID_EV00_012_m01_020": {
      "source_sha256": "22fd1cc04af50ab365a6a266ef709ec11bb7f87083251e31ce68724eb47456b0",
      "parts": [
        "خللا لو تركناه يستفحل لأهلك العالم بأسره."
      ]
    },
    "MID_EV00_012_m01_021": {
      "source_sha256": "2de7dded445fed6bc833f88ac0020a9e4417b020d4fe4ad3ba5aec21af30c227",
      "parts": [
        "ومنذ ذلك الحين وأنا أبحث عن محاربين أشداء\nلأجمعهم هنا في هذه اللحظة من الزمن."
      ]
    },
    "MID_EV00_012_m01_022": {
      "source_sha256": "59a7e0f8fc354df1c3f026ef80012f03d1ae7534f966d4a426012d53660a32e9",
      "parts": [
        "وفي تيار الأسباب والنتائج المضطرب،\nوجدت محاربين أهلا للمهمة."
      ]
    },
    "MID_EV00_012_m01_056": {
      "source_sha256": "12f1ebbb60f2712ea3af9823795052f7909ccf29849168f3e7d2835ceb809d9f",
      "parts": [
        "لكل منهم قوة مذهلة ونفس نبيلة. والواحد منهم يعدل ألفا."
      ]
    },
    "MID_EV00_012_m01_057": {
      "source_sha256": "01a494784ca5a60e1d8fd3de41a8d8c9e299ac0f02b8d996329df5cdeb7ce17a",
      "parts": [
        "ولنطلق عليهم... همم... سادة اللهب في داغدا."
      ]
    },
    "MID_EV00_012_m01_058": {
      "source_sha256": "a8124269e364133f55b21c73fb91f29f0f1cade8766a247551016f8483ce8ca5",
      "parts": [
        "من دونهم لن نظفر في المعارك المقبلة.\nفلنستمل منهم إلى صفنا كل من استطعنا."
      ]
    },
    "MID_EV00_012_m01_023": {
      "source_sha256": "d84ec976275dd0144237a02c196dcf875549b63119c5b6a3fb40e23e2cd666c6",
      "parts": [
        "وأين نجدهم؟"
      ]
    },
    "MID_EV00_012_m01_024": {
      "source_sha256": "22bce556760954c69bc3f3adf3425f70c41f79cd12e65ecaabc64a7f6e2f0a41",
      "parts": [
        "للأسف، ماتوا جميعا. وغدوا بيادق أخرى في يد بالور."
      ]
    },
    "MID_EV00_012_m01_025": {
      "source_sha256": "49e205b2f9977222322121f74e8e45d6c25deb40dd4348b8499b6d652808cd97",
      "parts": [
        "بل أذكر الآن أنك بارزتهم عند جسر ألسينيوس."
      ]
    },
    "MID_EV00_012_m01_026": {
      "source_sha256": "b1a7f0da245b8c0b0a8d3cd1ae3f58ac70c10c0b6af8097bf89830975c8342d8",
      "parts": [
        "ماذا؟! أنكون قد خسرنا الحرب قبل أن تبدأ؟!"
      ]
    },
    "MID_EV00_012_m01_027": {
      "source_sha256": "34c2be28c1c9e3e2b3474863dff69fa658553d257af24064ca099c4443c5fde2",
      "parts": [
        "لا داعي إلى كل هذا الذعر، فلدي خطة.\nوأنت بالذات، أريد منك حسن الإصغاء."
      ]
    },
    "MID_EV00_012_m01_028": {
      "source_sha256": "49b70103ed7b4b056dc78ff706885a5ecd32f93089770f86589610663e5bfbe0",
      "parts": [
        "بفضل المسلات التي في هذه القاعة،\nيمكنك التدخل في ماضي كل واحد من أولئك المحاربين."
      ]
    },
    "MID_EV00_012_m01_029": {
      "source_sha256": "f57252ce103356329b518c1cecae36be5b7d1303d5efc60a638c8b93c26f407a",
      "parts": [
        "وبها نطوع ما يربط الأسباب بنتائجها،\nفنقودهم سالمين إلى زمننا الحاضر."
      ]
    },
    "MID_EV00_012_m01_042": {
      "source_sha256": "ae1a710dbdeb4a1a094ee7fcaa5b62d8f5b49fc00a2119bb7d0cf17a3ce5ae72",
      "parts": [
        "مدهش. ما كان لأحد سوى إلهة أن يعيننا على مثل هذا الأمر."
      ]
    },
    "MID_EV00_012_m01_047": {
      "source_sha256": "d1edcacdd71f86a15e1a2e7fc0ebbc4df7ae11b0c997a589fd9b6e6090fdf93b",
      "parts": [
        "أجل... لكن سلطاني على الماضي محدود، حتى وأنا إلهة القدر."
      ]
    },
    "MID_EV00_012_m01_048": {
      "source_sha256": "a611d1a72ea5de72fda63c95c4ee5137aed8f929a6c68948a364b5b998a89c80",
      "parts": [
        "فمن الحوادث الجسام ما يعجزني رده، كبعث بالور مثلا."
      ]
    },
    "MID_EV00_012_m01_049": {
      "source_sha256": "2304c08638d1f79869ce731217587d13eda98aabf06547f7a9cc8cd2682f196b",
      "parts": [
        "ولو غيرت فيه شيئا يسيرا، لارتد مع الزمن إلى سابق عهده."
      ]
    },
    "MID_EV00_012_m01_050": {
      "source_sha256": "1fd93ff8d13bcd53e47ee5e93553715c7849b616cc3345dc29f1412e3ad3049b",
      "parts": [
        "سأفعل ما ينبغي فعله."
      ]
