{
  "1_DIT_Battle.msbt.zst": {
    "MID_SC12_17_m09_002": {
      "source_sha256": "bfce483a14f6537cd0ebecb2afef1d4eb48e15fffae1215c101d43b12f5bf2d0",
      "parts": [
        "يذكرني ذلك بالنخبة العشرة في فودلان. كانوا مثلهم تماما."
      ]
    }
  },
  "1_DIT_c02.msbt.zst": {
    "MID_EV12_003_m01_016": {
      "source_sha256": "bac145bb4bb92c1bc23e88e3828061fd337f1cd9039e8e2a2734c86a64b76449",
      "parts": [
        "تلك كانت معتقدات النخبة العشرة في فودلان."
      ]
    }
  },
  "1_DIT_c07.msbt.zst": {
    "MID_EV12_035_m01_002": {
      "source_sha256": "67b32fe33f1c3d848c894751fbfce7a5cfb86695f972a227cd8386382df67d65",
      "parts": [
        "نعم. أطلب إرسال فريق للتحقيق في أمر EX-477 وتيامات."
      ]
    },
    "MID_EV12_037_m01_021": {
      "source_sha256": "7da8aee2cb84c68f73e021d58bec1fcde849495035b789d9e7d6e8baf43a1b45",
      "parts": [
        "هذا... هذا أحد آثار أبطال فودلان! أيكون هذا الرجل سليلا لأحد\nأفراد النخبة العشرة؟!"
      ]
    }
  },
  "1_KAI_c02.msbt.zst": {
    "MID_EV11_100_m01_002": {
      "source_sha256": "912e60b3783ce678de4815eed52147e7fed5bab69d0a0bfc6e3785b3da38c478",
      "parts": [
        "يوم تتم الخامسة عشرة من عمرك تنقضي مهلتي."
      ]
    }
  },
  "1_LED_Battle.msbt.zst": {
    "MID_SC14_03_m03_002": {
      "source_sha256": "1d16f5698632b8f0e41e45b8407647d931fe97da79e24a2ac85ac02ae78017d1",
      "parts": [
        "والآن سأريك ما بلغته بجهدي، وسأضحك... هاها! حين تغص بمرارة\nالهزيمة!"
      ]
    },
    "MID_SC14_06_m01_005": {
      "source_sha256": "7540a1c30d7d2e2562d8da79826dac669d674c409c9a1304b7efd3139f68d939",
      "parts": [
        "معكم جميعا ذاك الشيء، أليس كذلك؟ تعرفون ما أعني؟\nفلنترقب اللحظة المناسبة تماما لاستخدامه."
      ]
    }
  },
  "1_LED_c03.msbt.zst": {
    "MID_EV14_015_m01_019": {
      "source_sha256": "3ae39664f63f615ad75516366c1a6e674490448006ea96acad374d14c199741a",
      "parts": [
        "في الثالثة عشرة من عمرها أصبحت أصغر من فاز بلقب «وردة\nكايلوس»."
      ]
    }
  },
  "1_LED_c05.msbt.zst": {
    "MID_EV14_026_m01_014": {
      "source_sha256": "cf50ed6424556fb1e2ba000bec0c9877478b52b1e227b094cf581a41b6a79665",
      "parts": [
        "أحيانا، حين أعزف على أوبسيديان، يتردد صوت في رأسي... وأعرف\nأنه ليس صوتي."
      ]
    }
  },
  "1_LED_c09.msbt.zst": {
    "MID_EV14_044_m01_010": {
      "source_sha256": "f1da74bd333548f18541206590a1a6f872014b2d52dd014c078d0a67adc049ad",
      "parts": [
        "لم أكن حتى أعزف على أوبسيديان... ومع ذلك سمعته."
      ]
    }
  },
  "1_SEO_c01.msbt.zst": {
    "MID_EV13_004_m01_013": {
      "source_sha256": "ff9ca99ecc5f53c1117af84adc8afaadb278c1e71c72ac7cb7c291784e862b42",
      "parts": [
        "آآخ!"
      ]
    }
  },
  "1_SEO_c02.msbt.zst": {
    "MID_EV13_007_m01_009": {
      "source_sha256": "4a55db64a1741e66ede2a758c968055e7b638884b6a5b883a9bfc59413d22199",
      "parts": [
        "لست وحدي. ففي مملكتنا لا يعتلي العرش إلا من بلغ سن الرشد،\nوهي عشرون سنة."
      ]
    }
  },
  "1_SEO_c07.msbt.zst": {
    "MID_EV13_038_m01_038": {
      "source_sha256": "43430fd05e692cfdcb8d7ae41cb2882e7338df1c792bd828fd934d130146ccb7",
      "parts": [
        "أرأيت يا رئيس؟ لا أعدك بشيء، لكنني أضمن لك أن\nالأمور ستكون على خير ما يرام!"
      ]
    }
  },
  "1_SEO_c09.msbt.zst": {
    "MID_EV13_045_m01_007": {
      "source_sha256": "0a4b57c772b3fc0ca7836207ab43f550e190c2858fb105b0cdd611081b0db8d3",
      "parts": [
