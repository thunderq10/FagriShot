  "Library.msbt.zst": {
    "MID_LIB_Hub_Memory005_m01_003": {
      "source_sha256": "40836ea262812ba2104f2a1e149be602954734a8a5f4359c4f781455393be124",
      "parts": [
        "الجيل 1\nصغرت هذه الطرز كثيرا قياسا بأسلافها، واستقر إنتاجها على نطاق\nواسع. ثم جاءت طرز الجيل 1.5 المحسنة أصغر حجما، فأمكن أخيرا\nزرعها في البشر. ومن هنا بدأت مرحلة جديدة من البحث فيها."
      ]
    },
    "MID_LIB_Hub_Memory005_m01_004": {
      "source_sha256": "76a0828cc3e5c1bfa0c65ff390b9759915bad7c0b733b93a4513b8f37ecbbda5",
      "parts": [
        "الجيل 2\nتحسن أداء هذا الطراز تحسنا كبيرا. فارتفعت قدرته القصوى كثيرا،\nوتضاعفت قدرته على إطالة العمر بمقادير هائلة. وزرع هذا الطراز\nلدى كثيرين من أفراد أطقم سفن سلسلة الأفعى."
      ]
    },
    "MID_LIB_Hub_Memory005_m01_005": {
      "source_sha256": "49b467875a34c9ce40ff1909a223c6bdbd6df8c7cc1eb090eeaaa90abf41077a",
      "parts": [
        "الجيل 3\nأتاحت مادة الإبيمينيوم، التي صنعت من عنصر جديد مثل اكتشافه\nنقلة علمية، درجة أعلى من التزامن الذهني في هذا الطراز. وكانت\nالنسخ الأولى عرضة لبعض الأخطاء، ثم أفضت التحسينات اللاحقة إلى\nأداء عال ومستقر."
      ]
    },
    "MID_LIB_Hub_Memory008_m01_002": {
      "source_sha256": "d2b6abd921bff541132b82858f6a2f00f456e305fc3851525db557ebf60161d6",
      "parts": [
        "EX-017\nملجأ شيد في شرقي المنطقة 1 السابقة للوقاية من الأسلحة\nالاستراتيجية. وهو من السعة بحيث يصح وصفه بمدينة تحت الأرض.\nوتتولى إدارته الصخرة العظمى «فيرمي». وانقطع اتصال كونلون\nبالشبكة فجأة، فبات مصير الملجأ مجهولا."
      ]
    },
    "MID_LIB_Hub_Memory008_m01_003": {
      "source_sha256": "848f0b36af884f9a7722dfc985c1ab6720d6063457efd6efbf7ba4c5fa0ec6fb",
      "parts": [
        "EX-053\nمنشأة تجارب وملجأ للطوارئ في آن واحد. نجت من أضرار جسيمة\nإبان الانهيار العظيم. وفيها خزان هائل مخصص لتجارب الرصد،\nوتتولى إدارتها الصخرة العظمى «بطليموس»."
      ]
    },
    "MID_LIB_Hub_Memory008_m01_005": {
      "source_sha256": "97200afdc7608ac63ad1dc27b9f23d0e6c601c8c4ae63d61dbe5c973b662a070",
      "parts": [
        "EX-089\nمنشأة تجارب مزودة بمسرع جسيمات هائل، تديرها الصخرة\nالعظمى «حنبعل». وفي داخلها المنشأة المغلقة EX-189، التي\nخصصت قديما لاختبار الأسلحة ثم أغلقت بعد فقدان السيطرة على\nأنظمتها."
      ]
    },
    "MID_LIB_Hub_Memory008_m01_006": {
      "source_sha256": "56855d0ff731204f4be22e91382b65e52ac08209fe10fcc866e68c0e1bc47ac6",
      "parts": [
        "EX-502\nتضم هذه المنطقة الجوفية قاعدة مصعد مداري ينقل المؤن إلى مدار\nالأقمار الاصطناعية. وتتولى إدارتها الصخرة العظمى «لانسيلوت».\nومنذ انقطاع اتصال كونلون بالشبكة فجأة، ظل مصير المنطقة\nمجهولا."
      ]
    },
    "MID_LIB_Hub_Memory009_m01_001": {
      "source_sha256": "c4e1e8ed01727ee2c218c0264c98d956a1f4ec21e9b0b4b9989c9cfb6dd9eb4e",
      "parts": [
        "كونلون اسم شبكة مستقلة تضم الصخور العظمى التي كانت تتبع\nالمنطقة 7 ونجت من الانهيار العظيم وما زالت تعمل. وتشمل أيضا\nتشانغ آه، العقل المدبر للمركبة 18 «نوا» من سلسلة الأفعى.\nويطلق اسم كونلون كذلك على القائمين على تشغيل هذه الشبكة."
      ]
    },
    "MID_LIB_Hub_Memory015_m01_001": {
      "source_sha256": "1f419fbfa9097f7c3a625235791d955cf9b0e2cd4b787efcbb1fab11fedd509a",
      "parts": [
        "«السمندل» اسم أسلحة نارية محمولة صنعت قديما لطاقم\n«نوا» وسلمت إلى أفراده. وتعرف رسميا باسم المدفع\nالكهربائي 96C. وهي تطلق حزما من الجسيمات المشحونة\nباستمداد الطاقة من المكثف المركب عند فوهتها، مما يجعلها\nفعالة على مسافات بعيدة."
      ]
    },
    "MID_LIB_Hub_Memory016_m01_001": {
      "source_sha256": "f7f87073024f1016615e2a3840d55a253d59bea6d35484278d264907cc54dcbd",
      "parts": [
        "المدفع الكهربائي 96C Mk. II، المعروف باسم «زيربيروس»، طراز\nمطور من «السمندل» صنع خصيصا للوسيط تروي. وعلى الرغم من\nقوته الهائلة، فإن سوء اتزانه يجعل التحكم فيه عسيرا على من لا\nيملك عضلات الوسيط المعززة."
      ]
    },
    "MID_LIB_Hub_Memory019_m01_002": {
      "source_sha256": "04ec1033d9eb5bd551974c96615488bafea504a0b965156cca535826de217022",
      "parts": [
        "لم يكن بلوغ هذا الحجم مقصودا عند بدء المشروع. فقد تبدلت\nأهداف التصميم أثناء العمل، فجاءت المركبة مجرد نسخة مكبرة\nمن «أومونونوشي»، المركبة 0 والنموذج الأولي لسلسلة الأفعى.\nوطالما تعرض هذا التصميم الفج للنقد، إذ لم يصمم كل جزء على\nالوجه الأمثل."
      ]
    },
    "MID_LIB_Hub_Memory026_m01_006": {
      "source_sha256": "7b8bc04c96572f6bdd7c3ea3f6270b0d5ca8250851dc94e2303e04bc79da5a82",
      "parts": [
        "أكتب هذا التقرير في ركن من EX-017، المنطقة الجوفية التي\nاحتميت بها مع زملائي، ولا يسعني إلا أن أتساءل. كيف انتهى بنا الأمر\nإلى هذا؟ ما ذلك الشيء؟ ومن أين أتى؟ ولماذا بادر فريترا إلى\nمهاجمته بهذا الحزم؟"
      ]
    }
  },
