      ]
    },
    "MID_EV00_005_m01_009": {
      "source_sha256": "af4e23d02ac0b145f4b4743f07cdb281036167b112f81578cff9001124781e22",
      "parts": [
        "«ماذا تعنين؟»"
      ]
    },
    "MID_EV00_005_m01_031": {
      "source_sha256": "0853a11fb85b6d3eb00c791f1c9ad61df4332fdccaa573dda3bc63af31ed5263",
      "parts": [
        "«الربان؟»"
      ]
    },
    "MID_EV00_005_m01_011": {
      "source_sha256": "847aa19fe63abf7537c6290fa0c11233d8f13a5ec5ab732e5382e7e90bd81e25",
      "parts": [
        "هذه ليست مجرد قرية."
      ]
    },
    "MID_EV00_005_m01_025": {
      "source_sha256": "75099ed6854321f689fbb5a1a2b309f2132259a50a55e020ede14beea4a071f7",
      "parts": [
        "قد لا تصدقني، لكنها كانت سفينة تجوب النجوم،\nوكان اسمها نوا."
      ]
    },
    "MID_EV00_005_m01_026": {
      "source_sha256": "ce84798992d3f1198c9b1488442aeeba8fb376179d10b4a9409b5eda89657770",
      "parts": [
        "قاد المعلم زينون هذه السفينة\nوعاش على متنها آلاف السنين."
      ]
    },
    "MID_EV00_005_m01_008": {
      "source_sha256": "af998e13e9bf673649bee523589727def2528a684d9af992aaa91ee9b07cc9ef",
      "parts": [
        "لعله كان يتمنى أن يرقد فيها إلى الأبد."
      ]
    },
    "MID_EV00_005_m01_019": {
      "source_sha256": "7e07823dddc021c5c7c2f454d0191a6550e5bcde4fb86cfdebdc2d3bc488c04f",
      "parts": [
        "قريبا ستبتلع الكثبان هذا المكان."
      ]
    },
    "MID_EV00_005_m01_020": {
      "source_sha256": "c517f15680e0d293284a86c3092c409f68093b3340ab41c482d892c38a688f6e",
      "parts": [
        "كل شيء، مهما عظم شأنه، يعود إلى التراب.\nولا سبيل إلى دفع ذلك."
      ]
    },
    "MID_EV00_005_m01_021": {
      "source_sha256": "3e448bbb3ca2c9ff53127d7a8bdeeab5034af948ba366d4c7aef9bb49727efd4",
      "parts": [
        "لكنني أريد المحاولة. أعقد آمالي عليك وعلى فورتونا."
      ]
    },
    "MID_EV00_005_m01_022": {
      "source_sha256": "39995459990a9b49142c50a02aa43834bee4e8966c7bf09f9df7086b3a770435",
      "parts": [
        "«ما خطوتنا التالية؟»"
      ]
    },
    "MID_EV00_005_m01_027": {
      "source_sha256": "b925cb2a810411a061257bbeab649c0be9a7bc1e610192dd9c5de29f9ab6b888",
      "parts": [
        "وجهتنا داغسيون، التي كانت عاصمة الإمبراطورية.\nلا بد أن فورتونا تنتظرنا هناك."
      ]
    },
    "MID_EV00_005_m01_028": {
      "source_sha256": "80f151e5b1276f228cfdd7de23a8df5dca7603bf21ed46450011788de776cc1b",
      "parts": [
        "وعدتها بأن آتي بك إليها."
      ]
    },
    "MID_EV00_005_m01_024": {
      "source_sha256": "fde59eb008571adaa44bdefd3e1f7e131e96a36a8534f96e0343cf6d9251213a",
      "parts": [
        "فاتبعني. سأدلك على الطريق."
      ]
    }
  },
