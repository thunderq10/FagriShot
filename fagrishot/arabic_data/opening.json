{
  "0_ISM_c01.msbt.zst": {
    "MID_EV00_000_m01_001": {
      "source_sha256": "8627f232596c3cbf82a6e86bbbb4aa311a0762afb47dab8ae81ffc4a8f9a415a",
      "parts": [
        "وهكذا تستولي جيوش العالم السفلي\nعلى معقل آخر للبشر."
      ]
    },
    "MID_EV00_000_m01_002": {
      "source_sha256": "157f43c0373f464c67eda35b89ed97fc62e0bcb191062a4fb69ff4a27a04bc49",
      "parts": [
        "فورتونا!"
      ]
    },
    "MID_EV00_000_m01_003": {
      "source_sha256": "23085b7c1b7cde469cb4c339a8af4c2056865dd95e2156399b8b0a4e1320ddb1",
      "parts": [
        "هونغ هوا، ماذا رأيت؟"
      ]
    },
    "MID_EV00_000_m01_004": {
      "source_sha256": "101886ab4a661f54b7b9ae86c1aaf8483215b0d3c90973e7ee885f36b7a4ae88",
      "parts": [
        "أهوالا. سووا اليوم ثلاث قرى بالأرض\nفي هذه الأنحاء. لم ينج أحد."
      ]
    },
    "MID_EV00_000_m01_005": {
      "source_sha256": "cfa8778e1ab01188078edcf22a518b1c0daff433909e5d4fc7cf05017e736763",
      "parts": [
        "إذن لم يبق من ننقذه. ما أقساهم!"
      ]
    },
    "MID_EV00_000_m01_006": {
      "source_sha256": "e7fedd4d97ab49b879e3b0af4caf9c82702d77820772b17aadab5ec888fb2b14",
      "parts": [
        "لم تبق في قلوبهم رحمة.\nلا يحركهم الآن إلا التعطش للقتل."
      ]
    },
    "MID_EV00_000_m01_021": {
      "source_sha256": "2f41a5eab8401c732148b6071ac10e94580f1cbd502f2eb947e0fbdfe4f6314a",
      "parts": [
        "أيتها الآلهة!"
      ]
    },
    "MID_EV00_000_m01_023": {
      "source_sha256": "ad63e76e31f3910079f48a62550e719de56c2430c239dbaa7defa9d2124d5a04",
      "parts": [
        "هذا حال كل مكان. جيوش العالم السفلي\nتفتك بكل ما يعترضها."
      ]
    },
    "MID_EV00_000_m01_024": {
      "source_sha256": "9e7f03bf0019feec64f4b3ce224ec5981634b1a06a37eeb9c1124f7204c35c39",
      "parts": [
        "من بقي من البشر يتشبث بالحياة،\nولا أدري إلى متى يصمد."
      ]
    },
    "MID_EV00_000_m01_032": {
      "source_sha256": "5b1827776b3ffb9122aa3d9196a9d8f05a196ff83a006c2234f0c233dd78bbda",
      "parts": [
        "فلنسرع إذن قبل أن يضيع كل شيء."
      ]
    },
    "MID_EV00_000_m01_033": {
      "source_sha256": "6703618404c705dabd9e85f4a93a85d50c9f34c082ac821e84e5c61e7b1a883c",
      "parts": [
        "وجهتنا الأرض المحرمة. دليني على الطريق."
      ]
    },
    "MID_EV00_100_m01_001": {
      "source_sha256": "6c9491d1f7ea052bb4def43bdc55fba5f24a8a43a4975935161ee8671ac18e78",
      "parts": [
        "ما أهدأ هذا المكان! لا أسمع إلا حفيف الرمل\nوهبوب الريح."
      ]
    },
    "MID_EV00_100_m01_002": {
      "source_sha256": "04d05d22f006b4618f3fbfd7a0e49952d045f53ed98e707db1ad6115866a728f",
      "parts": [
        "لا صراخ بشر هنا، ولا وقع أحذية الجنود،\nولا طقطقة النار في البيوت المحترقة."
      ]
    },
    "MID_EV00_100_m01_003": {
      "source_sha256": "f4383f9434c3fabc1e343aa4787ca5e8cc4601e1b5a5599b618cbecd0a878440",
      "parts": [
        "يا للمفارقة! لقد بنوا ذلك السور ليحبسونا هنا."
      ]
    },
    "MID_EV00_100_m01_004": {
      "source_sha256": "78405a7397280f37eee8de60d5ab202d79481e6e04b15e85e4d9fbe91427c3f4",
      "parts": [
        "وها هو اليوم يجعل هذا المكان أكثر بقاع داغدا أمنا."
      ]
    },
    "MID_EV00_100_m01_006": {
      "source_sha256": "3ee3d91a1de4ea6181ef3f9e8737e85bff9a79ec64fd1ce837c5252f59e276de",
      "parts": [
        "أفهم من كلامك أن لديك قلبا يحتاج إلى جسد جديد؟"
      ]
    },
    "MID_EV00_100_m01_007": {
      "source_sha256": "905b6c46e4b078e19e7af4b141991df8f1164b7ee5a1c7e130789fef336ea6bb",
      "parts": [
        "أجل. هل أنت أهل لهذه المهمة؟"
      ]
    },
    "MID_EV00_100_m01_008": {
      "source_sha256": "315017f08fc88603df23f9d7864b3a88b6d5570186b2cf0ccea912e3edbe0ccb",
      "parts": [
        "أحسبني أهلا لها. فليست هذه أول مرة\nأهيئ فيها جسدا على أحسن وجه."
      ]
    },
    "MID_EV00_100_m01_009": {
      "source_sha256": "c5f448f892019f42d526092103e3df939318f14358351541c760b0d656d8f0d2",
      "parts": [
        "حقا؟ يا لحسن حظنا! إذن لم تذهب رحلتنا سدى."
      ]
    },
    "MID_EV00_100_m01_010": {
      "source_sha256": "ad9947b800899f84b5b3a4aa221a80a7c22af1987ee864b33375caeb482e19df",
      "parts": [
        "إلا أن نوا بلغت أقصى طاقتها.\nفصنع الوسيط يستنزف قواها."
      ]
    },
    "MID_EV00_100_m01_013": {
      "source_sha256": "7b32e3182eee073d1c6fd55eefbc7be002b45658d36eb9d6d902133d2e383d7d",
      "parts": [
        "إن صح ما تقولينه عن أصل هذا القلب،\nفهو يستحق كل ما نبذله."
      ]
    },
    "MID_EV00_100_m01_014": {
      "source_sha256": "d87daf21fbe034f01fdb45b361e83ec39bccdb0a68c562d359276d92223f974e",
      "parts": [
        "ما سأصنعه يتجاوز حدود الحياة والموت،\nوالبشر والآلهة... وقد يكون فيه خلاصنا."
      ]
    },
    "MID_EV00_100_m01_018": {
      "source_sha256": "8e6cc685081708d2a1cdff6f9534c7d5e9e731158f89a0c89f2be6e14765d9f9",
      "parts": [
        "لا شك أن نوا تود أن تسهم في إحياء أمل البشر.\nوأنا كذلك."
      ]
    },
    "MID_EV00_100_m01_019": {
      "source_sha256": "a6b97ea49199b40eb0d6fe3f37fdbe18bd5486c691a05572db3b7fa4b430f8c1",
      "parts": [
        "بدأ حوض الحضانة يعمل. لم أستخدمه منذ زمن،\nلكن كل شيء يبدو على ما يرام."
      ]
    },
    "MID_EV00_100_m01_020": {
      "source_sha256": "3f644056883e376c915c0b74892935b93f35773c7d24ef54fe9c7154ea432075",
      "parts": [
        "ما إن يجهز الحوض حتى أضع فيه القلب مع نواة\nقلب، لنبدأ إنماء الجسد."
      ]
    },
    "MID_EV00_100_m01_021": {
      "source_sha256": "84abbc0d30345650101a7e67e541afac856324580a35113e16bece4a23345613",
      "parts": [
        "أيمكن لهذا الحوض أن ينشئ جسدا جديدا؟ يا للعجب!"
      ]
    },
    "MID_EV00_100_m01_022": {
      "source_sha256": "6f8cdac32ae62dc54f91b25667a02c218769d9553b6ed5a0d727b82eceb4a071",
      "parts": [
        "يدهشني أن تكون هناك نواة قلب ما زالت تعمل."
      ]
    },
    "MID_EV00_100_m01_024": {
      "source_sha256": "87837e317c5a6085a89c911b698694b9f3c5cb282078435459e2844b776eff35",
      "parts": [
        "لم يبق في الواقع إلا واحدة. نحن محظوظون."
      ]
    },
    "MID_EV00_100_m01_025": {
      "source_sha256": "968ead65914ee8b07d8e812a118759d26f1524a5bd5de709470fa4eacaa53984",
      "parts": [
        "سأستخدم النواة التي هنا."
      ]
    },
    "MID_EV00_100_m01_026": {
      "source_sha256": "83086b945f32c80dd90f109439a4cf05f9c47cc2959829289435d19df89edbc5",
      "parts": [
        "ماذا؟! لكن يا سيدي زينون،\nألا يودي ذلك بحياتك؟"
      ]
    },
    "MID_EV00_100_m01_027": {
      "source_sha256": "f7b7fdf746a566a03586e4276331a5296350bba1a2fe64f89338ee6d40a2c76b",
      "parts": [
        "وصلت نفسي بنوا من الخارج كي تمدني ببعض الطاقة."
      ]
    },
    "MID_EV00_100_m01_029": {
      "source_sha256": "0a5ce0911b9c3dacbd08d82f9105a0f01f32ac0cfd4f64d25ccee7d72964e77a",
      "parts": [
        "ينبغي أن تبقيني حيا حتى أفي بوعدي\nوآتيكم بمن ينقذنا."
      ]
    },
    "MID_EV00_100_m01_030": {
      "source_sha256": "a8a563452fb7da82f06f1e9bed193eec4f718abf060333f005acb0b1735bfd1e",
      "parts": [
        "لا أقبل بذلك! استخدم نواة قلبي عوضا عنها."
      ]
    },
    "MID_EV00_100_m01_031": {
      "source_sha256": "0ea9e02fe0f460ef6b864581617c94a0624cbc6bfd51ea586bd6f597cdb12583",
      "parts": [
        "وهل أجد سبيلا أفضل للتكفير عن ذنوبي؟"
      ]
    },
    "MID_EV00_100_m01_034": {
      "source_sha256": "1168c5f93961289c40129996b2442d17144b3cad3af9a9758a04fe02f67bf0f2",
      "parts": [
        "بل خير كفارة عما مضى أن تعملي من أجل\nمستقبل أفضل."
      ]
    },
    "MID_EV00_100_m01_035": {
      "source_sha256": "f48a4b57b196c882c795558f538b6cfd26ea9756d2c6ebbbbb140f4b75ee28b2",
      "parts": [
        "ما زال لديك ما تحيين من أجله.\nفمن سينقذنا سيحتاج إلى عونك."
      ]
    },
    "MID_EV00_100_m01_036": {
      "source_sha256": "ca923af4ae77c809ea25bb66be06ce21112a3232cb7a39c92ad4f517746f6a90",
      "parts": [
        "والآن... سأضع نواة القلب في مركز الطاقة\nأسفل البطن، تفاديا لارتداد الطاقة من القلب."
      ]
    },
    "MID_EV00_100_m01_037": {
      "source_sha256": "b78369393f69b4493418bca4fd63d89fe8de622bbdc76b4a4ea6731065f51f41",
      "parts": [
        "التصميم في مجمله يشبه تصميم أناتوليا."
      ]
    },
    "MID_EV00_100_m01_038": {
      "source_sha256": "0079f59bbe4635d32f597d1a3daa3f40e7663ec81952bf63a5145ef6dd5493e7",
      "parts": [
        "لكن لتبسيط العملية، قد أضطر إلى الاستغناء\nعن محرك النجوم السبعة في الآبار السماوية..."
      ]
    },
    "MID_EV00_100_m01_039": {
      "source_sha256": "f057362bcacab5edc0f676b08d8f680f7a9f08093d55cc1708a3079559ba1032",
      "parts": [
        "آخ... كح... كح..."
      ]
    },
    "MID_EV00_100_m01_040": {
      "source_sha256": "e1822c1ba1a40cbb617b474dc42ea6126e36bb556c800cb0cdd0f3fdea22ea51",
      "parts": [
        "حسبك يا سيدي زينون. استرح قليلا\nودع لي ما بقي."
      ]
    },
    "MID_EV00_100_m01_041": {
      "source_sha256": "b2ce3bb9987b11fdfab52a62a77320844ead07d17cc70154c8dad090c50fb7a1",
      "parts": [
        "نحن نصنع من سينقذ هذا العالم.\nوهذا يستحق حياة رجل عجوز."
      ]
    },
    "MID_EV00_100_m01_042": {
      "source_sha256": "18f33a5feba2e205c04271f4fe0a6349c73f888142425a1dc40a89379fb7b03c",
      "parts": [
        "سنبذل في سبيل ذلك كل ما بقي لنا...\nأنا وكونلون ونوا."
      ]
    },
    "MID_EV00_100_m01_043": {
      "source_sha256": "ce0469ac59dd30fe12e67c11dbf2896c77640fd0694619e628fbfea38a3d25fa",
      "parts": [
        "لم يبق لي من العمر كثير. لا أريد أن أتساءل\nفي النهاية إن كان بوسعي بذل المزيد."
      ]
    },
    "MID_EV00_001_m01_025": {
      "source_sha256": "644f56ba88abddaa7d53bf8fc6c19d6eec0bc5b955b4ce584776edda5d8f8cb5",
      "parts": [
        "همم؟"
      ]
    },
    "MID_EV00_001_m01_026": {
      "source_sha256": "7d88b2a4b848dd590e3766a5c783cf3ae6271facbf983f7eff87fc593ac7205d",
      "parts": [
        "ما هذا؟ أنسيتني بهذه السرعة؟"
      ]
    },
    "MID_EV00_001_m01_004": {
      "source_sha256": "0275d7a69a6a3677abab28b85959766415588b670b15096997a5af6df33aecc2",
      "parts": [
        "«من أنت؟»"
      ]
    },
    "MID_EV00_001_m01_031": {
      "source_sha256": "c875bb8b77742eadf80d90ed5bf9322045a7321fcf696d8d891ec5ef11e15920",
      "parts": [
        "«لا أذكر.»"
      ]
    },
    "MID_EV00_001_m01_027": {
      "source_sha256": "76d31e9cbd395664813e412053f85d326634e5aa04dda47462d7418f03750fdd",
      "parts": [
        "اسمي سوثيس، ولي اسم آخر هو «البداية»."
      ]
    },
    "MID_EV00_001_m01_028": {
      "source_sha256": "0d65759683eba94d102781a1d617d4b648fd3520262beb4fff7aa71e81ccf614",
      "parts": [
        "أيقظتك هذه المرة لتصلح ما كان منك."
      ]
    },
    "MID_EV00_001_m01_029": {
      "source_sha256": "e59fc663c558666ca350032c481e55fd61c4a6659ca91ec5b53403856d831e24",
      "parts": [
        "وأنت أولى من يتولى هذا الأمر."
      ]
    },
    "MID_EV00_001_m01_005": {
      "source_sha256": "d8050ad1648d15ebab3579acad03bc5e2afeab8963a475610bbb5f4e615c93ff",
      "parts": [
        "اعلم أن هذه الأرض تلفظ أنفاسها الأخيرة."
      ]
    },
    "MID_EV00_001_m01_006": {
      "source_sha256": "ef899222c1f3fe2a5087a83bdcc1f83eb6f31f0080ecc69ec834ce69392b8aa5",
      "parts": [
        "يخبو النور وتذبل النباتات، ومن بوابات الجحيم\nتندفع جموع الموتى العائدين إلى الحياة."
      ]
    },
    "MID_EV00_001_m01_007": {
      "source_sha256": "d74b970b724bf9bd98c36bf6c8dc0af9ccf427f9ffd60bcc1f1f4eb97ce38945",
      "parts": [
        "يزداد عدد القتلى كل يوم، وتأكل النيران\nالمزيد من المدن."
      ]
    },
    "MID_EV00_001_m01_008": {
      "source_sha256": "092fa56f9b6fdcf7f1e8f6035fa2a96329f19cc3212cbca2047a01f3ae86f5b9",
      "parts": [
        "تؤسر أرواح من يسقطون وتقدم قربانا لبالور."
      ]
    },
    "MID_EV00_001_m01_030": {
      "source_sha256": "f0b91d198215ed97e46b8dd3e8c111a3412d54b52ff5ea35fac2cfacdd5e391f",
      "parts": [
        "أفلا يؤسفك ما آل إليه الحال؟"
      ]
    },
    "MID_EV00_001_m01_015": {
      "source_sha256": "1d7bf260ce8e6fbe111e37cd9643929bc14c2b38ecd5ceec24d55bfd42bcd501",
      "parts": [
        "«علي أن أفعل شيئا.»"
      ]
    },
    "MID_EV00_001_m01_032": {
      "source_sha256": "18c9baa44c1e884a8fb79a7a62776c629dd945a2b1b842e60814f6209031ddac",
      "parts": [
        "«كيف لي أن أساعد؟»"
      ]
    },
    "MID_EV00_001_m01_016": {
      "source_sha256": "339f4dcaf659acd6c4c8ca1d9f455039eff70f24ff380679b9629d8c565d9a53",
      "parts": [
        "أخاطبك الآن بصفتي «البداية»."
      ]
    },
    "MID_EV00_001_m01_017": {
      "source_sha256": "220bbbeda81feda860996177cd13f7e2b63a51ded885f0d779995b019069d1b2",
      "parts": [
        "عليك أن تهزم بالور، ملك العالم السفلي،\nوتطرد ظلامه من هذه الأرض!"
      ]
    },
    "MID_EV00_001_m01_019": {
      "source_sha256": "bb7458694e461469b12ca5a852e935e48937559dd96a1677106e07b5814146b3",
      "parts": [
        "لقد كتب عليك أن تمضي في هذا الأمر حتى النهاية."
      ]
    },
    "MID_EV00_001_m01_020": {
      "source_sha256": "f4ffc088122285f43f787f7886c07b8e4c46913f5b68e1359f0dfb749f4fa9ff",
      "parts": [
        "إعادة النور إلى هذه الأرض الغارقة في الظلام...\nتلك مهمة تليق بك، في رأيي."
      ]
    },
    "MID_EV00_001_m01_021": {
      "source_sha256": "fbba38fe4ac61bee6a9e6fac82f0e040075047189e4d9e0886f8aeb50b1a46a9",
      "parts": [
        "ستكون فورتونا دليلك. إنها صوت القمة."
      ]
    },
    "MID_EV00_001_m01_022": {
      "source_sha256": "ee4b8b2c92f531babe88378f9658e7feb127fd045ddf6e52c09bf22144ffcb56",
      "parts": [
        "فأصغ إلى كلامها."
      ]
    },
    "MID_EV00_001_m01_024": {
      "source_sha256": "95ac4c92c193920fd6635c050e473883be24fda26f1ca50266619e119e554a1f",
      "parts": [
        "وما بقي فإليك أمره. دع كل شيء يمضي\nمع تيار الزمن..."
      ]
    },
    "MID_EV00_002_m01_001": {
      "source_sha256": "1d7e62f47b4a163298cd16ae47d90657932889fbfd0f45ebae460dba235c323e",
      "parts": [
        "همم. هل أفقت؟"
      ]
    },
    "MID_EV00_002_m01_002": {
      "source_sha256": "1b908953954d5d6a900c6ad6d8e5bfabc99ab4935109c9f579693d9e399aeabe",
      "parts": [
        "إذن لقيتها، وكتبت لك النجاة؟"
      ]
    },
    "MID_EV00_002_m01_003": {
      "source_sha256": "79adbc42609c50bf1d538cf07a348925a0fe9474525f7b789f35d684cf141bea",
      "parts": [
        "«أين أنا؟»"
      ]
    },
    "MID_EV00_002_m01_024": {
