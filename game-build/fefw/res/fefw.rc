// SPDX-License-Identifier: GPL-3.0-or-later
// Resources for fefw.exe: the app icon (res/fefw.ico, drawn by launcher/icon/make_icon.py) and the manifest (UTF-8 code page, long
// paths, asInvoker).
#include <winres.h>

IDI_APP ICON "fefw.ico"
1 24 "fefw.manifest"

1 VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "FagriShot\0"
            VALUE "FileVersion", "0.2.0\0"
            VALUE "InternalName", "fagrishot\0"
            VALUE "OriginalFilename", "FagriShot.exe\0"
            VALUE "ProductName", "FagriShot\0"
            VALUE "ProductVersion", "0.2.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
